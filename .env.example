# Copy to .env and adjust. NEVER commit the real .env (it is git-ignored).

# Password for the DVWA target's MySQL backend (lab-only, keep it boring).
DVWA_DB_PASSWORD=changeme

# Webhook used by tools/alert_forwarder.py to push high-severity alerts.
# Leave blank to run the forwarder in --dry-run mode.
ALERT_WEBHOOK_URL=
