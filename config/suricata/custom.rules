# Custom Suricata IDS rules for the lab. SIDs in the 1000000+ range are the
# local/private space. Load via `rule-files: [custom.rules]` in suricata.yaml.
# These give the network-layer view that complements the host-based Wazuh rules.

# --- Reconnaissance -----------------------------------------------------------
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"LAB SCAN Possible TCP port scan (SYN burst)"; flags:S; threshold:type both, track by_src, count 30, seconds 10; classtype:attempted-recon; sid:1000001; rev:1;)

# --- SSH brute force (network view) ------------------------------------------
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"LAB BRUTEFORCE Repeated SSH connections from single host"; flow:to_server; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-admin; sid:1000002; rev:1;)

# --- Web attacks --------------------------------------------------------------
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"LAB WEBATTACK SQL injection UNION SELECT"; flow:to_server,established; http.uri; content:"union"; nocase; content:"select"; nocase; distance:0; classtype:web-application-attack; sid:1000003; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"LAB WEBATTACK Path traversal attempt"; flow:to_server,established; http.uri; content:"../"; classtype:web-application-attack; sid:1000004; rev:1;)

# --- Malware delivery ---------------------------------------------------------
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"LAB MALWARE Suspicious shell script download"; flow:to_server,established; http.uri; content:".sh"; endswith; classtype:trojan-activity; sid:1000005; rev:1;)
